{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5433;Database=sentinel_fleet;Username=sentinel;Password=sentinel",
    "Redis": "localhost:6380",
    "RabbitMq": "amqp://sentinel:sentinel@localhost:5673/"
  },
  "Jwt": {
    "Issuer": "sentinel-fleet",
    "Audience": "sentinel-fleet",
    "SigningKey": "CHANGE_ME_local_dev_signing_key_min_32_chars!",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "AttachmentStorage": {
    "RootPath": "data/attachments"
  },
  "AnomalyService": {
    "BaseUrl": "http://localhost:8090",
    "TimeoutSeconds": 5
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
