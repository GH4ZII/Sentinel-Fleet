# Sentinel Fleet – local development environment
# Host ports below avoid common local conflicts; containers still use standard internal ports.

# PostgreSQL
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel_fleet
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6380

# RabbitMQ
RABBITMQ_USER=sentinel
RABBITMQ_PASSWORD=sentinel
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673

# API
API_PORT=8081
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Database=Host=postgres;Port=5432;Database=sentinel_fleet;Username=sentinel;Password=sentinel
ConnectionStrings__Redis=redis:6379
ConnectionStrings__RabbitMq=amqp://sentinel:sentinel@rabbitmq:5672/
Serilog__MinimumLevel=Information

# Web
WEB_PORT=3080
VITE_API_BASE_URL=
